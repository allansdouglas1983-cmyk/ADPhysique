{
  "expo": {
    "name": "Volyume",
    "slug": "volyume",
    "owner": "volyume",
    "extra": {
      "eas": {
        "projectId": "2f60a6ed-8b37-4cd6-8057-60ee04e39ea8"
      }
    },
    "scheme": "volyume",
    "version": "1.3.5",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/volyume-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0D0D0D",
    "primaryColor": "#F59E0B",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.volyume",
      "buildNumber": "10",
      "requireFullScreen": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSCameraUsageDescription": "Volyume uses the camera to scan barcodes, read nutrition labels, and take progress photos.",
        "NSMotionUsageDescription": "Volyume uses motion sensing for the shake-to-send-feedback gesture.",
        "NSLocationWhenInUseUsageDescription": "Volyume does not track your location. This entry is required by a bundled camera library and the permission is never requested.",
        "NSMicrophoneUsageDescription": "Volyume does not record audio. This entry is required by a bundled media library used for timer sounds and the permission is never requested.",
        "NSFaceIDUsageDescription": "Volyume uses Face ID to unlock the app when you turn on App lock in Settings > Privacy. Off unless you switch it on.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "sms",
          "mailto"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0D",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "package": "app.volyume",
      "versionCode": 3357,
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "volyume"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "volyume.app",
              "pathPrefix": "/partner"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/volyume-splash-blank.png",
          "imageWidth": 64,
          "backgroundColor": "#0D0D0D",
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/volyume-splash-blank.png",
            "backgroundColor": "#0D0D0D"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Volyume accesses your photos so you can save your workout share cards to your gallery.",
          "savePhotosPermission": "Volyume saves your workout share cards to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "workout",
              "title": "Start workout",
              "subtitle": "Build today's session",
              "icon": "symbol:dumbbell.fill",
              "params": {
                "href": "volyume://workout/start"
              }
            },
            {
              "id": "diary",
              "title": "Log food",
              "subtitle": "Open your food diary",
              "icon": "symbol:fork.knife",
              "params": {
                "href": "volyume://diary"
              }
            }
          ]
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Volyume uses Face ID to unlock the app when you turn on App lock in Settings > Privacy. Off unless you switch it on."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Volyume uses the camera to scan barcodes and read nutrition labels.",
          "enableCodeScanner": true,
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Volyume uses the camera to scan barcodes, read nutrition labels, and take progress photos. Progress photos stay on this device and are never uploaded.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F59E0B",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26,
            "buildToolsVersion": "36.0.0",
            "usesCleartextTraffic": false,
            "manifestQueries": {
              "package": [
                "com.whatsapp"
              ],
              "intent": [
                {
                  "action": "SENDTO",
                  "data": {
                    "scheme": "smsto"
                  }
                },
                {
                  "action": "SENDTO",
                  "data": {
                    "scheme": "mailto"
                  }
                },
                {
                  "action": "VIEW",
                  "data": {
                    "scheme": "sms"
                  }
                }
              ]
            }
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "volyume",
          "project": "volyume",
          "url": "https://sentry.io/"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextSession",
              "label": "Next session",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "description": "Your next training session at a glance.",
              "previewImage": "./assets/notification-icon.png",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "WeeklyConsistency",
              "label": "Weekly consistency",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "description": "Sessions done this week and weeks running.",
              "previewImage": "./assets/notification-icon.png",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "updatePeriodMillis": 1800000,
              "resizeMode": "none"
            }
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#F59E0B",
      "androidMode": "default"
    }
  }
}
